<div id="<%= dom_id email %>">
  <div>
    <strong>From:</strong>
    <%= email.from %>
  </div>

  <div>
    <strong>To:</strong>
    <%= email.to %>
  </div>

  <div>
    <strong>Subject:</strong>
    <%= email.subject %>
  </div>

  <div>
    <strong>Content:</strong>
    <%= email.content %>
  </div>

  <div>
    <strong>Attachment:</strong>
    <%= email.attachment %>
  </div>

</div>
