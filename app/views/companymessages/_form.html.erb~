<%= form_with(model: companymessage) do |form| %>
  <% if companymessage.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(companymessage.errors.count, "error") %> prohibited this companymessage from being saved:</h2>

      <ul>
        <% companymessage.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.hidden_field :company_id %>
  </div>

  <div>
    <%= form.label :employee_id, "Qui es-tu ?", style: "display: block" %>
