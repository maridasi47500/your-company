<%= form_with(model: post) do |form| %>
  <% if post.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(post.errors.count, "error") %> prohibited this post from being saved:</h2>

      <ul>
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.hidden_field :employee_id %>
  </div>

  <div>
    <%= form.label :content, style: "display: block" %>
    <%= form.textarea :content, placeholder: "say something", style: "width: 100%;min-height:100px;" %>
  </div>

  <div>
    <%= form.label :pic, "attach a pic", style: "display: block" %>
    <%= form.file_field :pic %>
  </div>

  <div>
    <%= form.submit "Share" %>
  </div>
<% end %>
