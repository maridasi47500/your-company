<div id="<%= dom_id employee %>">
  <div>
    <strong>Fullname:</strong>
    <%= employee.fullname %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= employee.email %>
  </div>

  <div>
    <strong>Password:</strong>
    <%= employee.password %>
  </div>

  <div>
    <strong>Pic:</strong>
    <%= employee.pic %>
  </div>

  <div>
    <strong>Dob:</strong>
    <%= employee.dob %>
  </div>

  <div>
    <strong>Company:</strong>
    <%= employee.company %>
  </div>

  <div>
    <strong>City:</strong>
    <%= employee.city %>
  </div>

  <div>
    <strong>Gender:</strong>
    <%= employee.gender %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= employee.description %>
  </div>

</div>
