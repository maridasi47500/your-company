<%= form_with(model: friendrequest) do |form| %>
  <% if friendrequest.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(friendrequest.errors.count, "error") %> prohibited this friendrequest from being saved:</h2>

      <ul>
        <% friendrequest.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    
    <%= form.hidden_field :employee_id %>
  </div>

  <div>
    <%= form.label :friend_id, "and i assume you are", style: "display: block" %>
    <%= form.collection_select :friend_id, Employee.all.where.not(id: friendrequest.employee_id), :id, :fullname %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
