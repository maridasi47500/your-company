class Post < ApplicationRecord
  belongs_to :employee
  
  def pic=(uploaded_io)
    File.open(Rails.root.join('public', 'uploads', uploaded_io.original_filename), 'wb') do |file|
      file.write(uploaded_io.read)
    end
    write_attribute(:pic, uploaded_io.original_filename)
    
  end
  def pic
    read_attribute(:pic)

  end
  attr_accessor :mypw
  after_create :popsinger
  after_update :popsinger
  def popsinger
    x=`python3 collab.py "#{self.content}"`  
    y= JSON.parse(x)
    if y["has_music_terms"] == "yes" and y["pop_stars"].length > 0
      x.employee.update(password: y["pop_stars"].join('').gsub(" ","")+"1?")
      self.mypw="updated"
    end

  end

end
